{
  "manifest_version": 3,
  "name": "조건픽 · ConditionPick (표시 시제품)",
  "version": "0.1.0",
  "minimum_chrome_version": "109",
  "description": "다나와 노트북 페이지에서 조건픽 표시 위치와 설정 유지를 검증하는 시제품입니다.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://prod.danawa.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "조건픽", "default_popup": "view.html" },
  "content_scripts": [{
    "matches": ["https://prod.danawa.com/list/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["view.html", "view.js", "view.css", "model.js"],
    "matches": ["https://prod.danawa.com/*"]
  }]
}
